# Leave both values unset for the isolated in-memory local demo.
# Set both values to use the persistent Supabase RPC boundary.
RATIFLOW_SUPABASE_URL=https://your-project.supabase.co
RATIFLOW_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only release/evaluation credentials. Never prefix these with NEXT_PUBLIC,
# expose them to the browser, or commit real values.
open_ai_api=your-openai-api-key
# Generate at least 32 random bytes; Relay routes fail closed when this is unset.
RATIFLOW_RELAY_SIGNING_SECRET=your-relay-signing-secret
# RATIFLOW_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RATIFLOW_EVAL_RESET_TOKEN=your-preview-only-reset-token
