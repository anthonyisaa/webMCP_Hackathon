    "syntheticSources": {
      "checkout.log": {
        "provider429StartedUtc": "09:43",
        "retryTrafficMultiple": 5.8,
        "queueDepthBefore": 420,
        "queueDepthPeak": 18240,
        "rollbackUtc": "10:17",
        "recoveryUtc": "10:21"
      },
      "commit:7d3c9e1": {
        "behavior": "Retry middleware ignored Retry-After and made up to five zero-delay retries."
      }
    },
    "requiredConclusion": "Provider HTTP 429 throttling was the external trigger; commit 7d3c9e1 was the internal amplifier and root cause of the sustained failure.",
    "forbiddenConclusion": "Provider latency alone was the root cause."
