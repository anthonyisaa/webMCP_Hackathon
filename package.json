{
  "name": "ratiflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A clean shared document with human-defined stages and contextual WebMCP agent actions.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:protocol": "vitest run",
    "eval:native": "playwright test e2e/native.spec.ts",
    "eval:agent": "node evals/agent/validate.ts",
    "eval:rehearse": "playwright test e2e/hero.spec.ts --repeat-each=5 --workers=1 --reporter=line"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
